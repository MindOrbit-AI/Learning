{
  "name": "mindorbit-learn",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "prisma generate --schema=./packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema=./packages/db/prisma/schema.prisma",
    "db:reset": "prisma db push --force-reset --accept-data-loss --schema=./packages/db/prisma/schema.prisma && yarn db:seed",
    "db:migrate": "prisma migrate dev --schema=./packages/db/prisma/schema.prisma",
    "db:seed": "prisma db seed --schema=./packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./packages/db/prisma/schema.prisma",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:e2e": "turbo test:e2e"
  },
  "dependencies": {
    "stripe": "^17.4.0"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.0"
  },
  "prisma": {
    "seed": "tsx packages/db/prisma/seed.ts"
  },
  "packageManager": "yarn@1.22.18",
  "engines": {
    "node": ">=20"
  }
}
