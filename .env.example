# Database
DATABASE_URL="postgresql://mindorbit:mindorbit_dev@localhost:5433/mindorbit"
# Transaction poolers (PgBouncer transaction mode, Supabase pooler, etc.): Prisma must not pin prepared statements
# across pooled backends. Auto-enabled for *.pooler.supabase.com; for other poolers set:
# PRISMA_TRANSACTION_POOL=true
# (Or append ?pgbouncer=true to DATABASE_URL yourself.) If errors mention PGBOUNCER_* and your pooler is new,
# try removing pgbouncer=true / PRISMA_TRANSACTION_POOL — see Prisma PgBouncer docs.

# API (optional - defaults to same origin for Next.js)
NEXT_PUBLIC_API_URL=""

# Canonical site URL for SEO (Open Graph, sitemap). Example: https://learn.yourdomain.com
NEXT_PUBLIC_APP_URL=""

# AI - Missions, concept extraction, diagnostics (real OpenAI when set; mock when unset)
OPENAI_API_KEY=""
# Required for many project / service keys (sk-proj-*, sk-svc*): Project ID from https://platform.openai.com/settings
OPENAI_PROJECT_ID=""
# Optional org header when your account uses multiple orgs
OPENAI_ORG_ID=""

# Music engine — set when running apps/music-engine; Next.js `/api/music/generate-song` proxies here
MUSIC_ENGINE_URL="http://localhost:3010"
# If 3010 is busy (EADDRINUSE), set PORT=3011 in apps/music-engine/.env and match MUSIC_ENGINE_URL to that port
# Optional: HTTP cron for top-node pregenerate (same secret in scheduler header `x-music-cron-secret`)
MUSIC_CRON_SECRET=""

# Auth (NextAuth v4) — set at least one of these; production requires a strong random value
NEXTAUTH_SECRET="your-random-32-plus-character-string-here"
# Optional alias (used if NEXTAUTH_SECRET is unset)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"


# Google OAuth (optional, placeholder)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Billing (mock when unset; Stripe when all three are set)
BILLING_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""