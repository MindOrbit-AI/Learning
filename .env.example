# Database
DATABASE_URL="postgresql://mindorbit:mindorbit_dev@localhost:5433/mindorbit"

# API (optional - defaults to same origin for Next.js)
NEXT_PUBLIC_API_URL=""

# Canonical site URL for SEO (Open Graph, sitemap). Example: https://learn.yourdomain.com
NEXT_PUBLIC_APP_URL=""

# AI - Missions, games, concept extraction, diagnostics (mock when no key below is set)
# Direct OpenAI (default model gpt-4o-mini; override with OPENAI_MODEL)
OPENAI_API_KEY=""
# Optional: custom base URL (e.g. proxy). If it points at Vercel AI Gateway, use OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_BASE_URL=""
OPENAI_MODEL=""
# Or Vercel AI Gateway only (default base https://ai-gateway.vercel.sh/v1, model openai/gpt-4o-mini)
AI_GATEWAY_API_KEY=""
AI_GATEWAY_BASE_URL=""

# Auth (NextAuth v4) — set at least one of these; production requires a strong random value
NEXTAUTH_SECRET="your-random-32-plus-character-string-here"
# Optional alias (used if NEXTAUTH_SECRET is unset)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"


# Google OAuth (optional, placeholder)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Billing (mock when unset; Stripe when all three are set)
BILLING_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""