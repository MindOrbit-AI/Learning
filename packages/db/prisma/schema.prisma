// MindOrbit Learn - Prisma Schema

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NodeState {
  mastered
  weak
  missing
  learning
  untouched
}

enum QuestionType {
  multiple_choice
  short_answer
  true_false
}

enum MissionStatus {
  not_started
  in_progress
  completed
}

enum ResourceType {
  note
  summary
  flashcard_set
  diagram
  walkthrough
  mini_lesson
}

enum ReviewStatus {
  pending
  in_progress
  completed
}

enum RelationshipType {
  prerequisite
  related
  extends
}

enum UserRole {
  STUDENT
  CREATOR
  ADMIN
  SUPER_ADMIN
}

enum PlanTier {
  FREE
  PRO
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  CANCELED
  PAST_DUE
  EXPIRED
  TRIALING
}

enum SubjectStatus {
  draft
  published
  archived
}

enum ClusterStatus {
  active
  archived
}

enum ConceptStatus {
  draft
  published
  archived
}

enum EdgeStatus {
  active
  archived
}

enum QuestionStatus {
  draft
  published
  archived
}

enum ResourceStatus {
  pending
  approved
  rejected
  flagged
  archived
}

enum MissionTemplateStatus {
  draft
  published
  archived
}

enum MissionType {
  learn     // legacy, maps to discover
  creator   // legacy
  discover
  repair
  simulation
  challenge
  review
}

enum SceneType {
  observe
  manipulate
  predict
  reveal
  simulate
  drag_drop
  slider_experiment
  tap_highlight
  sort_sequence
  find_error
  construct_answer
  micro_quiz
  reflect
  transfer
}

enum MistakeCategory {
  prerequisite_gap
  concept_confusion
  calculation_error
  procedural_error
  careless_error
  terminology_confusion
}

model User {
  id                     String             @id @default(cuid())
  name                   String?
  email                  String             @unique
  emailVerified          DateTime?
  passwordHash           String?
  image                  String?
  bio                    String?
  gradeLevel             String?
  studyGoal              String?
  targetExams            String[]           @default([])
  streakCount              Int                @default(0)
  bestMissionStreak        Int                @default(0)
  lastMissionCompletedAt   DateTime?
  xp                       Int                @default(0)
  onboardingCompleted    Boolean            @default(false)
  role                   UserRole           @default(STUDENT)
  suspendedAt            DateTime?
  planTier               PlanTier           @default(FREE)
  subscriptionStatus    SubscriptionStatus @default(INACTIVE)
  billingCustomerId      String?
  billingSubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  canceledAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  accounts               Account[]
  sessions               Session[]
  diagnosticAttempts     DiagnosticAttempt[]
  userNodeStates         UserNodeState[]
  missions               Mission[]
  resources              Resource[]
  resourceLikes          ResourceLike[]
  resourceSaves          ResourceSave[]
  userBadges             UserBadge[]
  reviewQueueItems       ReviewQueueItem[]
  notifications          Notification[]
  userEvents             UserEvent[]
  uploadedSources        UploadedSource[]
  featureUsages          FeatureUsage[]
  billingEvents          BillingEvent[]
  subjectLibraryAdds     UserSubjectAdd[]

  @@index([planTier])
  @@index([subscriptionStatus])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token      String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subject {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  description   String
  icon          String
  color         String
  gradeBand     String?
  status        SubjectStatus @default(draft)
  version       Int           @default(1)
  createdById   String?
  updatedById   String?
  orderIndex    Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  clusters      Cluster[]
  conceptNodes  ConceptNode[]
  conceptEdges  ConceptEdge[]
  diagnosticQuestions DiagnosticQuestion[]
  diagnosticAttempts  DiagnosticAttempt[]
  resources     Resource[]
  missionTemplates MissionTemplate[]
  libraryAdds      UserSubjectAdd[]
}

/// User added someone else's published subject to their library (listed on /subjects, dashboard, etc.).
model UserSubjectAdd {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([userId])
  @@index([subjectId])
}

model Cluster {
  id          String        @id @default(cuid())
  subjectId   String
  slug        String
  title       String
  description String
  orderIndex  Int           @default(0)
  status      ClusterStatus @default(active)
  subject     Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  conceptNodes ConceptNode[]
  resources   Resource[]

  @@unique([subjectId, slug])
}

model ConceptNode {
  id                 String        @id @default(cuid())
  subjectId          String
  clusterId          String
  slug               String
  title              String
  description        String
  difficulty         String        @default("medium")
  orderIndex         Int           @default(0)
  status             ConceptStatus @default(draft)
  canonicalCode      String?
  learningObjective  String?
  prerequisiteCount Int?
  positionX          Float?
  positionY          Float?
  subject            Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  cluster            Cluster       @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  outEdges           ConceptEdge[] @relation("SourceNode")
  inEdges            ConceptEdge[] @relation("TargetNode")
  diagnosticQuestions DiagnosticQuestion[]
  diagnosticResponses DiagnosticResponse[]
  userNodeStates     UserNodeState[]
  missions           Mission[]
  resources          Resource[]
  reviewQueueItems   ReviewQueueItem[]
  missionTemplates   MissionTemplate[]

  @@unique([subjectId, slug])
}

model ConceptEdge {
  id               String           @id @default(cuid())
  subjectId        String
  sourceNodeId     String
  targetNodeId     String
  relationshipType RelationshipType @default(prerequisite)
  weight           Float            @default(1)
  status           EdgeStatus       @default(active)
  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sourceNode       ConceptNode      @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode       ConceptNode      @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([subjectId, sourceNodeId, targetNodeId])
}

model DiagnosticQuestion {
  id            String        @id @default(cuid())
  subjectId     String
  nodeId        String
  prompt        String
  type          QuestionType
  optionsJson   String?
  correctAnswer String
  explanation   String
  difficulty    String        @default("medium")
  status        QuestionStatus @default(draft)
  tagsJson      String?
  subject       Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  node          ConceptNode   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  responses     DiagnosticResponse[]
}

model DiagnosticAttempt {
  id              String   @id @default(cuid())
  userId          String
  subjectId       String
  startedAt      DateTime @default(now())
  completedAt     DateTime?
  overallScore    Float?
  masteryScore    Float?
  confidenceScore Float?
  stabilityScore  Float?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  responses       DiagnosticResponse[]

  @@index([userId, subjectId])
}

model DiagnosticResponse {
  id             String   @id @default(cuid())
  attemptId      String
  questionId     String
  nodeId         String
  selectedAnswer String
  isCorrect      Boolean
  responseTimeMs Int?
  attempt        DiagnosticAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       DiagnosticQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  node           ConceptNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model UserNodeState {
  id             String    @id @default(cuid())
  userId         String
  subjectId      String
  nodeId         String
  state          NodeState @default(untouched)
  mastery        Float     @default(0)
  confidence     Float     @default(0)
  stability      Float     @default(0)
  decay          Float     @default(0)
  lastPracticedAt DateTime?
  nextReviewAt   DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  node           ConceptNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId, nodeId])
  @@index([userId, nodeId])
}

model Mission {
  id               String        @id @default(cuid())
  userId           String
  subjectId        String
  nodeId           String
  title            String
  missionType      MissionType   @default(discover)
  status           MissionStatus @default(not_started)
  explanation      String?
  example          String?
  reflectionPrompt String?
  variationPrompt  String?
  estimatedMinutes Int           @default(15)
  xpReward         Int           @default(25)
  xpGranted        Int?
  starsGranted     Int?
  currentSceneIndex Int          @default(0)
  createdAt        DateTime      @default(now())
  completedAt      DateTime?
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  node             ConceptNode   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  tasks            MissionTask[]
  scenes          MissionScene[]
  progress         MissionProgress?
  sceneResponses   MissionSceneResponse[]
}

model MissionTask {
  id            String       @id @default(cuid())
  missionId     String
  type          QuestionType
  prompt        String
  optionsJson   String?
  correctAnswer String
  explanation   String?
  orderIndex    Int          @default(0)
  mission       Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model MissionScene {
  id                  String    @id @default(cuid())
  missionId           String
  sceneType           SceneType
  title               String
  prompt              String
  contentJson         String?
  interactionModel    String?
  validationRulesJson String?
  correctAnswerJson   String?
  explanation         String?
  hintLevel1          String?
  hintLevel2          String?
  hintLevel3          String?
  orderIndex          Int       @default(0)
  mission             Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  responses           MissionSceneResponse[]

  @@index([missionId, orderIndex])
}

model MissionProgress {
  id              String   @id @default(cuid())
  missionId       String   @unique
  completedIndices String  // JSON array of completed scene indices
  answersJson     String?  // Partial answers for resume
  updatedAt       DateTime @updatedAt
  mission         Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model MissionSceneResponse {
  id               String          @id @default(cuid())
  missionId        String
  sceneId          String
  userAnswerJson   String
  isCorrect        Boolean
  attempts         Int             @default(1)
  mistakeCategory  MistakeCategory?
  respondedAt      DateTime        @default(now())
  mission          Mission         @relation(fields: [missionId], references: [id], onDelete: Cascade)
  scene            MissionScene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([missionId, sceneId])
}

model Resource {
  id           String         @id @default(cuid())
  userId       String
  subjectId    String
  clusterId    String
  nodeId       String
  type         ResourceType
  title        String
  description  String?
  contentJson  String?
  thumbnailUrl String?
  status       ResourceStatus @default(pending)
  flagReason   String?
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  cluster      Cluster        @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  node         ConceptNode    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  likes        ResourceLike[]
  saves        ResourceSave[]

  @@index([nodeId])
  @@index([subjectId])
  @@index([status])
}

model ResourceLike {
  id         String   @id @default(cuid())
  resourceId String
  userId     String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
}

model ResourceSave {
  id         String   @id @default(cuid())
  resourceId String
  userId     String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
}

model Badge {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  icon        String
  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model ReviewQueueItem {
  id         String       @id @default(cuid())
  userId     String
  subjectId  String
  nodeId     String
  dueAt      DateTime
  priority   Int          @default(1)
  status     ReviewStatus @default(pending)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  node       ConceptNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserEvent {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  payload   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UploadedSource {
  id          String   @id @default(cuid())
  userId      String
  subjectId   String?
  clusterId   String?
  sourceType  String
  sourceUrl   String?
  content     String?
  summaryJson String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parsedChunks ParsedChunk[]
  conceptExtractions ConceptExtraction[]
}

model ParsedChunk {
  id             String   @id @default(cuid())
  sourceId       String
  content        String
  orderIndex     Int      @default(0)
  source         UploadedSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model ConceptExtraction {
  id         String   @id @default(cuid())
  sourceId   String
  nodeId     String?
  conceptText String
  confidence Float   @default(0)
  source     UploadedSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model MissionTemplate {
  id                    String                @id @default(cuid())
  subjectId             String
  nodeId                String
  title                 String
  missionType           MissionType           @default(discover)
  explanationTemplate   String
  workedExampleTemplate String?
  reflectionPrompt      String?
  variationPrompt       String?
  estimatedMinutes      Int                   @default(15)
  difficulty            String                @default("medium")
  status                MissionTemplateStatus @default(draft)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  subject               Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  node                  ConceptNode           @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  scenes                MissionTemplateScene[]
}

model MissionTemplateScene {
  id                  String           @id @default(cuid())
  templateId          String
  sceneType           SceneType
  title               String
  prompt              String
  contentJson         String?
  interactionModel    String?
  validationRulesJson String?
  correctAnswerJson   String?
  explanation         String?
  hintLevel1          String?
  hintLevel2          String?
  hintLevel3          String?
  orderIndex          Int              @default(0)
  template            MissionTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, orderIndex])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String
  entityType   String
  entityId     String
  action       String
  beforeJson   String?
  afterJson    String?
  createdAt    DateTime @default(now())
}

model FeatureUsage {
  id          String   @id @default(cuid())
  userId      String
  featureKey  String
  usageCount  Int      @default(0)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureKey, periodStart])
  @@index([userId, featureKey])
  @@index([userId, featureKey, periodStart])
}

model BillingEvent {
  id               String   @id @default(cuid())
  userId           String?
  eventType        String
  provider         String
  externalEventId  String?
  payloadJson      String?
  createdAt        DateTime @default(now())
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
